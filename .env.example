# ==============================================================================
# SMART HOME ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và điền thông tin tương ứng của bạn.
# ==============================================================================

# ─── THÔNG TIN TÀI KHOẢN HOME ASSISTANT ──────────────────────────────────────
HA_ADMIN1_NAME="Admin 1"
HA_ADMIN1_USERNAME="admin1"
HA_ADMIN1_PASSWORD="your_secure_password"

HA_ADMIN2_NAME="Admin 2"
HA_ADMIN2_USERNAME="admin2"
HA_ADMIN2_PASSWORD="your_secure_password"

# Home Assistant Long-Lived Access Token
HA_LONG_LIVED_ACCESS_TOKEN="your_long_lived_access_token_here"

# ─── HỆ THỐNG FRIGATE NVR & GO2RTC ────────────────────────────────────────────
FRIGATE_RTSP_PASSWORD="your_frigate_rtsp_password"
RECORDINGS_PATH="/mnt/hdd/camera_recordings"
TIMEZONE="Asia/Ho_Chi_Minh"

# ─── SONOFF / EWELINK ────────────────────────────────────────────────────────
SONOFF_USERNAME="your_email@gmail.com"
SONOFF_PASSWORD="your_sonoff_password"
SONOFF_COUNTRY_CODE="+84"

# ─── TUYA CLOUD ──────────────────────────────────────────────────────────────
TUYA_USER_CODE="your_user_code"
TUYA_UID="your_uid"
TUYA_ACCESS_TOKEN="your_access_token"
TUYA_REFRESH_TOKEN="your_refresh_token"
TUYA_ENDPOINT="https://apigw-sg.iotbing.com"

# ─── MQTT BROKER ──────────────────────────────────────────────────────────────
MQTT_HOST="127.0.0.1"
MQTT_PORT="1883"
